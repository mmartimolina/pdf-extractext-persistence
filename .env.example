# Microservicio pdf-persistence: variables de configuración.
# Copiar a .env si se desean valores distintos. NUNCA subir .env a Git
# ni incluir credenciales reales en este archivo.

# --- Puerto HTTP ---
# Puerto local del servicio (aplicación y host). 8003 evita conflictos
# con Extract, Validation y Summarize.
PORT=8003

# --- MongoDB (servicio externo) ---
# URI de conexión. Puede incluir usuario y contraseña en entornos reales:
#   mongodb://usuario:password@host:27017
# En el entorno Compose local se usa el nombre DNS del servicio.
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=pdf_persistence
MONGO_COLLECTION=documents
MONGO_TIMEOUT_MS=5000

# --- Servicio ---
LOG_LEVEL=INFO
